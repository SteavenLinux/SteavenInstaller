#!/usr/bin/env bash
# Runs inside the installed system. Configuration is passed as environment data,
# never interpolated into generated shell source.
set -Eeuo pipefail
IFS=$'\n\t'

msg() {
    printf '\n=== %s ===\n\n' "$1"
}

# Ensure all required variables are set before proceeding
required_variables=("TARGET_HOSTNAME" "TARGET_TIMEZONE" "TARGET_LOCALE" "TARGET_SECONDARY_LOCALE" "TARGET_DESKTOP" "TARGET_USERNAME" "TARGET_ROOT_PASSWORD" "TARGET_USER_PASSWORD" "TARGET_CACHYOS_REPOS")

# Loop through each required variable and check if it's set
for variable in "${required_variables[@]}"; do
  if [[ -z ${!variable:-} ]]; then
        msg "Missing configuration: $variable"
    exit 1
  fi
done

TARGET_CACHYOS_REPOS=${TARGET_CACHYOS_REPOS,,}
TARGET_DESKTOP=${TARGET_DESKTOP,,}

[[ $TARGET_CACHYOS_REPOS == yes || $TARGET_CACHYOS_REPOS == no ]] || {
    msg 'TARGET_CACHYOS_REPOS must be yes or no.'
    exit 1
}

case "$TARGET_DESKTOP" in
    gnome) DESKTOP_PACKAGE=SteavenLinux-gnome-meta ;;
    kde) DESKTOP_PACKAGE=SteavenLinux-plasma-meta ;;
    *) msg 'TARGET_DESKTOP must be GNOME or KDE.'; exit 1 ;;
esac

if [[ $TARGET_CACHYOS_REPOS == yes ]]; then
    msg 'Adding CachyOS repositories'
    pacman-key --recv-keys F3B607488DB35A47 --keyserver keyserver.ubuntu.com
    pacman-key --lsign-key F3B607488DB35A47
    pacman -U --needed --noconfirm \
        'https://mirror.cachyos.org/repo/x86_64/cachyos/cachyos-keyring-20240331-1-any.pkg.tar.zst' \
        'https://mirror.cachyos.org/repo/x86_64/cachyos/cachyos-mirrorlist-27-1-any.pkg.tar.zst' \
        'https://mirror.cachyos.org/repo/x86_64/cachyos/cachyos-v3-mirrorlist-27-1-any.pkg.tar.zst' \
        'https://mirror.cachyos.org/repo/x86_64/cachyos/cachyos-v4-mirrorlist-27-1-any.pkg.tar.zst'
    install -Dm644 /root/pacman-cachyos.conf /etc/pacman.conf
    rm -f /root/pacman-cachyos.conf
    pacman -Syu --needed --noconfirm linux-cachyos linux-cachyos-headers
fi

if [[ $TARGET_CACHYOS_REPOS == no ]]; then
    pacman -Syu --needed --noconfirm linux-zen linux-zen-headers
fi

msg 'Setting timezone and locale'
ln -sf "/usr/share/zoneinfo/$TARGET_TIMEZONE" /etc/localtime
hwclock --systohc
printf '%s UTF-8\n%s UTF-8\n' "$TARGET_LOCALE" "$TARGET_SECONDARY_LOCALE" > /etc/locale.gen
locale-gen
printf 'LANG=%s\n' "$TARGET_LOCALE" > /etc/locale.conf
printf '%s\n' "$TARGET_HOSTNAME" > /etc/hostname

# Set the root password
msg "Setting the root password..."
echo "$TARGET_ROOT_PASSWORD" | chpasswd

# Create a new user with the specified username
msg "Creating user $TARGET_USERNAME..."
useradd --create-home --groups wheel --shell /usr/bin/bash "$TARGET_USERNAME"

# Set the password for the new user
msg "Setting the password for $TARGET_USERNAME..."
echo "$TARGET_USER_PASSWORD" | chpasswd

# Add the user to additional groups
msg "Adding $TARGET_USERNAME to audio, video, render, input, storage, and games groups..."
groups_to_add=("audio" "video" "render" "input" "storage" "games")
for group in "${groups_to_add[@]}"; do
    if getent group "$group" >/dev/null; then
        usermod -aG "$group" "$TARGET_USERNAME"
    fi
done

# Configure sudo permissions for the wheel group
msg 'Configuring sudo permissions'
sudo_config="%wheel ALL=(ALL:ALL) ALL"
echo "$sudo_config" > /etc/sudoers.d/10-wheel
visudo -cf /etc/sudoers.d/10-wheel

msg 'Installing necessary packages'
pacman -Syu --needed --noconfirm grub efibootmgr networkmanager flatpak "$DESKTOP_PACKAGE"
flatpak remote-add --if-not-exists --system flathub https://dl.flathub.org/repo/flathub.flatpakrepo
flatpak install --system --noninteractive flathub io.gitlab.librewolf-community
grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=GRUB
grub-mkconfig -o /boot/grub/grub.cfg
systemctl enable NetworkManager
case "$TARGET_DESKTOP" in
    gnome) systemctl enable gdm.service ;;
    kde) systemctl enable plasmalogin.service ;;
esac
