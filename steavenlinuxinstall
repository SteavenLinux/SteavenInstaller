#!/usr/bin/env bash
# Run from an Arch Linux live environment booted in UEFI mode.
set -Eeuo pipefail
IFS=$'\n\t'
umask 077

readonly DEFAULT_HOSTNAME=SteavenLinux DEFAULT_TIMEZONE=Africa/Cairo DEFAULT_LOCALE=en_US.UTF-8
readonly DEFAULT_SECONDARY_LOCALE=ar_EG.UTF-8 DEFAULT_DESKTOP=SteavenLinux-gnome-meta DEFAULT_USERNAME=steavengameryt
ROOT_PASSWORD='' USER_PASSWORD=''

msg() { printf '\n=== %s ===\n\n' "$1"; }
warn() { printf 'Warning: %s\n' "$1" >&2; }
die() { printf 'Error: %s\n' "$1" >&2; exit 1; }
on_exit() { local status=$?; unset ROOT_PASSWORD USER_PASSWORD; (( status == 0 )) || warn 'Installation stopped; mounts were left in place for recovery.'; }
trap on_exit EXIT

need() { command -v "$1" >/dev/null 2>&1 || die "Required command is missing: $1"; }
prompt() { local value; read -r -p "$1 [$2]: " value; printf '%s\n' "${value:-$2}"; }
yes_no() { local value; while true; do read -r -p "$1 [$2]: " value; case "${value:-$2}" in yes|y|YES|Y) echo yes; return;; no|n|NO|N) echo no; return;; *) warn 'Enter yes or no.';; esac; done; }
partition_path() { [[ $1 =~ [0-9]$ ]] && printf '%sp%s\n' "$1" "$2" || printf '%s%s\n' "$1" "$2"; }

asset() {
    local here
    here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
    [[ -f "$here/$1" ]] && printf '%s\n' "$here/$1" && return
    [[ -f "/usr/share/steaveninstaller/$1" ]] && printf '%s\n' "/usr/share/steaveninstaller/$1" && return
    die "Required installer asset is missing: $1"
}

validate_disk() {
    local disk source name mounted
    disk=$(readlink -f -- "$1") || die "Cannot resolve disk: $1"
    [[ -b $disk && $(lsblk -dnro TYPE "$disk") == disk ]] || die 'Choose a whole disk such as /dev/sda or /dev/nvme0n1.'
    source=$(findmnt -nro SOURCE / 2>/dev/null || true)
    [[ $(readlink -f -- "$source" 2>/dev/null || true) != "$disk" ]] || die 'Refusing to erase the running system disk.'
    while read -r name mounted; do [[ -z ${mounted:-} ]] || die "Refusing to erase $disk: $name is mounted at $mounted."; done < <(lsblk -nrpo NAME,MOUNTPOINT "$disk")
    printf '%s\n' "$disk"
}

validate_settings() {
    [[ $HOSTNAME =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]] || die 'Invalid hostname.'
    [[ $USERNAME =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die 'Invalid username.'
    [[ -f "/usr/share/zoneinfo/$TIMEZONE" ]] || die "Unknown timezone: $TIMEZONE"
    for locale in "$LOCALE" "$SECONDARY_LOCALE"; do [[ $locale =~ ^[a-zA-Z_]+\.UTF-8$ && -f "/usr/share/i18n/locales/${locale%.UTF-8}" ]] || die "Unknown locale: $locale"; done
}

password() {
    local label=$1 first second
    while true; do
        read -r -s -p "$label: " first; printf '\n'; [[ -n $first ]] || { warn 'Passwords cannot be empty.'; continue; }
        read -r -s -p "Confirm $label: " second; printf '\n'
        [[ $first == "$second" ]] && { printf '%s' "$first"; return; }; warn 'Passwords did not match.'
    done
}

choose_desktop() {
    local desktop
    while true; do
        desktop=$(prompt 'Desktop (SteavenLinux-gnome-meta or SteavenLinux-plasma-meta)' "$DEFAULT_DESKTOP")
        case $desktop in SteavenLinux-gnome-meta|SteavenLinux-plasma-meta) printf '%s\n' "$desktop"; return;; *) warn 'Choose GNOME or Plasma.';; esac
    done
}

prepare_automatic() {
    local confirmation
    msg 'Automatic disk setup'; echo "This permanently erases every file on $DISK."; lsblk -d -o NAME,SIZE,MODEL "$DISK"
    read -r -p "Type exactly 'ERASE $DISK' to continue: " confirmation
    [[ $confirmation == "ERASE $DISK" ]] || die 'Disk erase cancelled.'
    parted --script "$DISK" mklabel gpt
    parted --script "$DISK" mkpart ESP fat32 1MiB 2049MiB
    parted --script "$DISK" set 1 esp on
    parted --script "$DISK" mkpart root ext4 2049MiB 100%
    partprobe "$DISK"; udevadm settle
    EFI_PART=$(partition_path "$DISK" 1); ROOT_PART=$(partition_path "$DISK" 2)
    [[ -b $EFI_PART && -b $ROOT_PART ]] || die 'New partitions were not detected.'
    msg 'Formatting and mounting partitions'
    mkfs.fat -F 32 "$EFI_PART"; mkfs.ext4 -F "$ROOT_PART"
    mount "$ROOT_PART" /mnt; mkdir -p /mnt/boot; mount "$EFI_PART" /mnt/boot
}

verify_manual() {
    msg 'Manual disk setup'
    echo 'Prepare root at /mnt and the EFI System Partition at /mnt/boot.'
    echo 'Manual mode never partitions, formats, mounts, or unmounts a filesystem.'
    read -r -p 'Press Enter after the filesystems are ready.'
    mountpoint -q /mnt || die '/mnt is not mounted.'; mountpoint -q /mnt/boot || die '/mnt/boot is not mounted.'
    findmnt /mnt /mnt/boot
    [[ $(yes_no 'Continue with these mounted filesystems?' no) == yes ]] || die 'Installation cancelled.'
}

install_system() {
    local mirrorlist config setup
    msg 'Installing base system'
    pacstrap -K /mnt base base-devel git sudo linux-firmware efibootmgr plymouth flatpak mkinitcpio networkmanager chaotic-mirrorlist chaotic-keyring SteavenSettings SteavenLinuxName
    mirrorlist=/etc/pacman.d/steavenrepo-mirrorlist
    [[ -f $mirrorlist ]] || die 'The SteavenLinux mirror list is missing from the live environment.'
    install -Dm644 "$mirrorlist" /mnt/etc/pacman.d/steavenrepo-mirrorlist
    genfstab -U /mnt > /mnt/etc/fstab
    config=$(asset pacman-arch.conf)
    install -Dm644 "$config" /mnt/etc/pacman.conf
    if [[ $CACHYOS_REPOS == yes ]]; then
        config=$(asset pacman-cachyos.conf)
        install -Dm644 "$config" /mnt/root/pacman-cachyos.conf
    fi
    setup=$(asset configure-system); install -Dm700 "$setup" /mnt/root/configure-system
    msg 'Configuring installed system'
    arch-chroot /mnt /usr/bin/env "TARGET_HOSTNAME=$HOSTNAME" "TARGET_TIMEZONE=$TIMEZONE" "TARGET_LOCALE=$LOCALE" "TARGET_SECONDARY_LOCALE=$SECONDARY_LOCALE" "TARGET_DESKTOP=$DESKTOP" "TARGET_USERNAME=$USERNAME" "TARGET_ROOT_PASSWORD=$ROOT_PASSWORD" "TARGET_USER_PASSWORD=$USER_PASSWORD" "TARGET_CACHYOS_REPOS=$CACHYOS_REPOS" /root/configure-system
    rm -f /mnt/root/configure-system
}

main() {
    (( EUID == 0 )) || die 'Run this installer as root.'
    [[ -d /sys/firmware/efi/efivars ]] || die 'Boot the live environment in UEFI mode.'
    for command in arch-chroot curl findmnt genfstab lsblk mkfs.ext4 mkfs.fat mount mountpoint pacman-key pacstrap parted partprobe readlink systemctl timedatectl udevadm; do need "$command"; done
    msg 'Checking internet connection'
    local attempt; for ((attempt=1; attempt<=30; attempt++)); do curl -fsS --max-time 5 https://archlinux.org/ >/dev/null && break; sleep 2; done
    (( attempt <= 30 )) || die 'No internet connection after 60 seconds.'
    pacman-key --init; pacman-key --populate archlinux; timedatectl set-ntp true
    local mode; mode=$(prompt 'Disk setup: automatic or manual' automatic)
    case $mode in automatic|auto) echo 'Available disks:'; lsblk -d -o NAME,SIZE,MODEL,TYPE; DISK=$(validate_disk "$(prompt 'Target disk' /dev/sda)"); mode=automatic;; manual) mode=manual;; *) die 'Choose automatic or manual.';; esac
    HOSTNAME=$(prompt Hostname "$DEFAULT_HOSTNAME"); TIMEZONE=$(prompt Timezone "$DEFAULT_TIMEZONE")
    LOCALE=$(prompt 'Primary locale' "$DEFAULT_LOCALE"); SECONDARY_LOCALE=$(prompt 'Secondary locale' "$DEFAULT_SECONDARY_LOCALE")
    DESKTOP=$(choose_desktop); USERNAME=$(prompt Username "$DEFAULT_USERNAME"); CACHYOS_REPOS=$(yes_no 'Enable CachyOS repositories?' no)
    validate_settings; ROOT_PASSWORD=$(password 'Root password'); USER_PASSWORD=$(password "Password for $USERNAME")
    [[ $mode == automatic ]] && prepare_automatic || verify_manual
    install_system; unset ROOT_PASSWORD USER_PASSWORD
    msg 'Installation complete'; echo 'Exit the live environment, unmount /mnt, and reboot when ready.'
}
main "$@"
