#!/usr/bin/env bash
# Run from an Arch Linux live environment booted in UEFI mode.
set -Eeuo pipefail
IFS=$'\n\t'
umask 077

# Define default system settings
readonly DEFAULT_HOSTNAME="SteavenLinux"
readonly DEFAULT_TIMEZONE="Africa/Cairo"
readonly DEFAULT_LOCALE="en_US.UTF-8"
readonly DEFAULT_SECONDARY_LOCALE="ar_EG.UTF-8"
readonly DEFAULT_DESKTOP="gnome"
readonly DEFAULT_USERNAME="steavengameryt"

# Define default user and root passwords (leave blank for manual input)
ROOT_PASSWORD=''
USER_PASSWORD=''

msg() {
    printf '\n=== %s ===\n\n' "$1"
}

warn() {
    printf 'Warning: %s\n' "$1" >&2
}

die() {
    printf 'Error: %s\n' "$1" >&2
    exit 1
}

on_exit() {
    local status=$?
    unset ROOT_PASSWORD USER_PASSWORD
    if (( status == 0 )); then
        printf 'Installation completed successfully.\n'
    else
        warn 'Installation stopped; mounts were left in place for recovery.'
    fi
}
trap on_exit EXIT

need() {
    if ! command -v "$1" >/dev/null 2>&1; then
        die "Required command is missing: $1"
    fi
}

prompt() {
    local value
    read -r -p "$1 [$2]: " value
    printf '%s\n' "${value:-$2}"
}

yes_no() {
    local value
    while true; do
        read -r -p "$1 [$2]: " value
        case "${value:-$2}" in
            [Yy]* | [Yy][Ee][Ss])
                echo yes
                return
                ;;
            [Nn]* | [Nn][Oo])
                echo no
                return
                ;;
            *)
                warn 'Enter yes or no.'
                ;;
        esac
    done
}

partition_path() {
    if [[ $1 =~ [0-9]$ ]]; then
        printf '%sp%s\n' "$1" "$2"
    else
        printf '%s%s\n' "$1" "$2"
    fi
}

asset() {
    local here
    here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
    [[ -f "$here/$1" ]] && printf '%s\n' "$here/$1" && return
    [[ -f "/usr/share/steaveninstaller/$1" ]] && printf '%s\n' "/usr/share/steaveninstaller/$1" && return
    die "Required installer asset is missing: $1"
}

validate_disk() {
    local disk source name mounted
    disk=$(readlink -f -- "$1") || die "Cannot resolve disk: $1"
    [[ -b $disk && $(lsblk -dnro TYPE "$disk") == disk ]] || die 'Please choose a whole disk such as /dev/sda or /dev/nvme0n1.'
    source=$(findmnt -nro SOURCE / 2>/dev/null || true)
    [[ $(readlink -f -- "$source" 2>/dev/null || true) != "$disk" ]] || die 'Refusing to erase the running system disk.'
    while read -r name mounted; do [[ -z ${mounted:-} ]] || die "Refusing to erase $disk: $name is mounted at $mounted."; done < <(lsblk -nrpo NAME,MOUNTPOINT "$disk")
    printf '%s\n' "$disk"
}

validate_settings() {
    [[ $HOSTNAME =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]] || die 'Invalid hostname. Please use only letters, numbers, and hyphens.'
    [[ $USERNAME =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die 'Invalid username. Please use only lowercase letters, numbers, underscores, and hyphens.'
    [[ -f "/usr/share/zoneinfo/$TIMEZONE" ]] || die "Unknown timezone: $TIMEZONE"
    for locale in "$LOCALE" "$SECONDARY_LOCALE"; do [[ $locale =~ ^[a-zA-Z_]+\.UTF-8$ && -f "/usr/share/i18n/locales/${locale%.UTF-8}" ]] || die "Unknown locale: $locale"; done
}

get_passwords() {
    while true; do
        read -r -s -p 'Password for Root: ' ROOT_PASSWORD
        printf '\n'

        read -r -s -p 'Password for Root confirm: ' ROOT_PASSWORD_CONFIRM
        printf '\n'

        read -r -s -p "Password for $USERNAME: " USER_PASSWORD
        printf '\n'

        read -r -s -p "Password for $USERNAME confirm: " USER_PASSWORD_CONFIRM
        printf '\n'

        if [[ -z $ROOT_PASSWORD || -z $USER_PASSWORD ]]; then
            warn 'Passwords cannot be empty.'
            continue
        fi

        if [[ $ROOT_PASSWORD != "$ROOT_PASSWORD_CONFIRM" ]]; then
            warn 'Root passwords did not match.'
            continue
        fi

        if [[ $USER_PASSWORD != "$USER_PASSWORD_CONFIRM" ]]; then
            warn 'User passwords did not match.'
            continue
        fi

        unset ROOT_PASSWORD_CONFIRM USER_PASSWORD_CONFIRM
        return
    done
}

choose_desktop() {
    local desktop
    while true; do
        desktop=$(prompt 'Choose Desktop Environment (GNOME or KDE)' "$DEFAULT_DESKTOP")
        case "${desktop,,}" in gnome) printf 'gnome\n'; return;; kde) printf 'kde\n'; return;; *) warn 'Please choose between GNOME or KDE.';; esac
    done
}

prepare_automatic() {
    local confirmation
    msg 'Automatic disk setup'; echo "This permanently erases every file on $DISK."; lsblk -d -o NAME,SIZE,MODEL "$DISK"
    read -r -p "Type exactly 'ERASE $DISK' to continue: " confirmation
    [[ $confirmation == "ERASE $DISK" ]] || die 'Disk erase cancelled.'
    parted --script "$DISK" mklabel gpt
    parted --script "$DISK" mkpart ESP fat32 1MiB 2049MiB
    parted --script "$DISK" set 1 esp on
    parted --script "$DISK" mkpart root ext4 2049MiB 100%
    partprobe "$DISK"; udevadm settle
    EFI_PART=$(partition_path "$DISK" 1); ROOT_PART=$(partition_path "$DISK" 2)
    [[ -b $EFI_PART && -b $ROOT_PART ]] || die 'New partitions were not detected.'
    msg 'Formatting and mounting partitions'
    mkfs.fat -F 32 "$EFI_PART"; mkfs.ext4 -F "$ROOT_PART"
    mount "$ROOT_PART" /mnt; mkdir -p /mnt/boot; mount "$EFI_PART" /mnt/boot
}

verify_manual() {
    msg 'Manual disk setup'
    echo 'Prepare root at /mnt and the EFI System Partition at /mnt/boot.'
    echo 'Manual mode never partitions, formats, mounts, or unmounts a filesystem.'
    read -r -p 'Press Enter after the filesystems are ready.'
    mountpoint -q /mnt || die '/mnt is not mounted.'; mountpoint -q /mnt/boot || die '/mnt/boot is not mounted.'
    findmnt /mnt /mnt/boot
    [[ $(yes_no 'Continue with these mounted filesystems?' no) == yes ]] || die 'Installation cancelled.'
}

install_system() {
    local mirrorlist config setup
    msg 'Installing base system'
    # Use the prepared live-environment keyring. -K would create a new target
    # keyring that does not yet trust the required third-party repositories.
    pacstrap /mnt base base-devel git sudo linux-firmware efibootmgr plymouth flatpak mkinitcpio networkmanager chaotic-mirrorlist chaotic-keyring SteavenSettings SteavenLinuxName
    mirrorlist=/etc/pacman.d/steavenrepo-mirrorlist
    [[ -f $mirrorlist ]] || die 'The SteavenLinux mirror list is missing from the live environment.'
    install -Dm644 "$mirrorlist" /mnt/etc/pacman.d/steavenrepo-mirrorlist
    genfstab -U /mnt > /mnt/etc/fstab
    config=$(asset pacman-arch.conf)
    install -Dm644 "$config" /mnt/etc/pacman.conf
    if [[ $CACHYOS_REPOS == yes ]]; then
        config=$(asset pacman-cachyos.conf)
        install -Dm644 "$config" /mnt/root/pacman-cachyos.conf
    fi
    setup=$(asset configure-system); install -Dm700 "$setup" /mnt/root/configure-system
    msg 'Configuring installed system'

msg 'Configuring installed system'
arch-chroot /mnt /usr/bin/env \
    "TARGET_HOSTNAME=$HOSTNAME" \
    "TARGET_TIMEZONE=$TIMEZONE" \
    "TARGET_LOCALE=$LOCALE" \
    "TARGET_SECONDARY_LOCALE=$SECONDARY_LOCALE" \
    "TARGET_DESKTOP=$DESKTOP" \
    "TARGET_USERNAME=$USERNAME" \
    "TARGET_ROOT_PASSWORD=$ROOT_PASSWORD" \
    "TARGET_USER_PASSWORD=$USER_PASSWORD" \
    "TARGET_CACHYOS_REPOS=$CACHYOS_REPOS" \
    "SCRIPT_NAME=$(basename "$setup")" \
    /root/configure-system

main() {
    # Ensure the script is run as root
    if [[ $EUID -ne 0 ]]; then
        echo "Please run this installer as root."
        exit 1
    fi

    # Check if the live environment is booted in UEFI mode
    if [[ ! -d /sys/firmware/efi/efivars ]]; then
        echo "Please boot the live environment in UEFI mode."
        exit 1
    fi

    # Check if necessary commands are available
    for command in arch-chroot curl findmnt genfstab lsblk mkfs.ext4 mkfs.fat mount mountpoint pacman pacman-key pacstrap parted partprobe readlink systemctl timedatectl udevadm; do
        if ! command -v "$command" &> /dev/null; then
            echo "Missing command: $command"
            exit 1
        fi
    done

    # Check internet connection
    echo "Checking internet connection..."
    local attempt
    for ((attempt=1; attempt<=30; attempt++)); do
        if curl -fsS --max-time 5 https://archlinux.org/ &> /dev/null; then
            break
        fi
        sleep 2
    done
    if (( attempt > 30 )); then
        echo "No internet connection after 60 seconds."
        exit 1
    fi

    # Set system clock to NTP
    timedatectl set-ntp true

    # Prepare trusted package keyrings
    echo "Preparing trusted package keyrings..."
    pacman-key --init
    pacman-key --populate archlinux
    pacman-key --recv-keys 5D47A0A4882E9619CCF7D0A57FD4F55D1E0AA9CA --keyserver keyserver.ubuntu.com
    pacman-key --lsign-key 5D47A0A4882E9619CCF7D0A57FD4F55D1E0AA9CA
    pacman-key --recv-keys 3056513887B78AEB --keyserver keyserver.ubuntu.com
    pacman-key --lsign-key 3056513887B78AEB
    pacman -Sy --needed --noconfirm archlinux-keyring
    pacman -U --needed --noconfirm \
        'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-keyring.pkg.tar.zst' \
        'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-mirrorlist.pkg.tar.zst'

    # Choose disk setup mode
    local mode
    while true; do
        read -r -p "Disk setup: automatic or manual? [automatic/manual] " mode
        case $mode in
            automatic|auto)
                echo 'Available disks:'
                lsblk -d -o NAME,SIZE,MODEL,TYPE
                DISK=$(validate_disk "$(prompt 'Target disk' /dev/sda)")
                break
                ;;
            manual)
                mode=manual
                break
                ;;
            *)
                echo "Choose 'automatic' or 'manual'."
                ;;
        esac
    done

    # Collect system settings
    HOSTNAME=$(prompt Hostname "$DEFAULT_HOSTNAME")
    TIMEZONE=$(prompt Timezone "$DEFAULT_TIMEZONE")
    LOCALE=$(prompt 'Primary locale' "$DEFAULT_LOCALE")
    SECONDARY_LOCALE=$(prompt 'Secondary locale' "$DEFAULT_SECONDARY_LOCALE")
    DESKTOP=$(choose_desktop)
    USERNAME=$(prompt Username "$DEFAULT_USERNAME")
    CACHYOS_REPOS=$(yes_no 'Enable CachyOS repositories?' no)

    # Validate settings
    validate_settings
    ROOT_PASSWORD=$(password 'Root password')
    USER_PASSWORD=$(password "Password for $USERNAME")

    # Disk setup
    if [[ $mode == automatic ]]; then
        prepare_automatic
    else
        verify_manual
    fi

    # Install the system
    install_system
    unset ROOT_PASSWORD USER_PASSWORD

    # Final message
    msg 'Installation complete'
    echo 'Exit the live environment, unmount /mnt, and reboot when ready.'
}
main "$@"